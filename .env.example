# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in real values. Never commit `.env*.local`.
#   cp .env.example .env.local
#
# WARNING: every VITE_* variable is inlined into the browser bundle at build
# time and is therefore PUBLIC. Never put a private key or server-side secret
# here — use the backend for anything that must stay secret.
# ---------------------------------------------------------------------------

# Base URL of the backend API. Leave empty in development to use the Vite
# dev-server proxy (see vite.config.ts).
VITE_API_BASE_URL=https://api.example.com

# --- Supabase (public, client-side) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
# Anon/public key only. NEVER the service_role key.
VITE_SUPABASE_ANON_KEY=

# --- Gemini (optional, direct browser calls) ---
# WARNING: this key ships to the browser and can be extracted by anyone.
# Prefer routing generation through the backend proxy (POST /api/lessons/:id/llm)
# and leaving these empty.
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# --- Dev server overrides (optional) ---
# Host the Vite dev server binds to. Default: 127.0.0.1
VITE_DEV_HOST=
# Target the /api proxy forwards to. Default: http://localhost:3001
VITE_DEV_API=

# --- Build (optional) ---
# Canonical origin used by scripts/generate-sitemap.mjs. Default: https://vibecoderai.ru
SITE_URL=
